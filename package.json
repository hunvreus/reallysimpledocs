{
  "name": "reallysimpledocs",
  "version": "1.0.11",
  "description": "A simple documentation system for Astro, built with Basecoat and Tailwind CSS.",
  "author": {
    "name": "hunvreus",
    "url": "https://x.com/hunvreus"
  },
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hunvreus/reallysimpledocs.git"
  },
  "bugs": {
    "url": "https://github.com/hunvreus/reallysimpledocs/issues"
  },
  "homepage": "https://reallysimpledocs.com",
  "keywords": [
    "astro",
    "documentation",
    "docs",
    "markdown",
    "mdx",
    "basecoat",
    "tailwindcss",
    "llms"
  ],
  "exports": {
    ".": "./src/index.js",
    "./astro": "./src/astro/index.js",
    "./components": "./src/components/index.js",
    "./css": "./src/css/custom.css",
    "./css/styles/*": "./src/css/styles/*.css",
    "./css/styles/*.css": "./src/css/styles/*.css"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "rm -rf dist && astro build",
    "preview": "astro preview",
    "smoke:consumer": "node scripts/smoke-consumer.mjs",
    "check": "npm run build && node scripts/assert-site-output.mjs && npm pack --dry-run && npm run smoke:consumer"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/mdx": "^6.0.3",
    "@tailwindcss/vite": "4.1.17",
    "github-slugger": "^2.0.0",
    "lucide-static": "^0.552.0",
    "lunr": "^2.3.9",
    "marked": "^16.4.1",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "shiki": "^4.1.0",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "astro": "^6.4.6",
    "basecoat-css": "^1.0.1",
    "tailwindcss": ">=4.1.17 <5"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^6.4.6",
    "basecoat-css": "^1.0.1",
    "htmx.org": "^2.0.10",
    "tailwindcss": "4.1.17"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "picomatch": "^4.0.4"
  }
}
