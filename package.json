    "lucide-static": "^0.552.0",
    "lunr": "^2.3.9",
    "marked": "^16.4.1",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "shiki": "^4.1.0",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "astro": "^6.4.6",
    "basecoat-css": "^1.0.0-beta.6",
    "tailwindcss": ">=4.1.17 <5"
  },
  "devDependencies": {
    "astro": "^6.4.6",
    "basecoat-css": "^1.0.0-beta.6",
    "htmx.org": "^2.0.10",
    "tailwindcss": "4.1.17"
