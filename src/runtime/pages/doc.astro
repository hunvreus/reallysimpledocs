---
import config from "virtual:reallysimpledocs/config";
import { getMdxPage } from "virtual:reallysimpledocs/mdx-pages";
import DocsLayout from "../components/DocsLayout.astro";
import { getDocHeadings, getPages, renderDoc } from "../lib/docs.js";
import { routeSlug } from "../lib/paths.js";

export function getStaticPaths() {
  return getPages(config).map((page) => ({
    params: { slug: routeSlug(page.slug) },
    props: { page },
  }));
}

const { page } = Astro.props;
const isMdx = page.extension === ".mdx";
const mdxModule = isMdx ? await getMdxPage(page.slug) : null;
const MdxContent = mdxModule?.Content || mdxModule?.default;
const doc = isMdx ? { page, headings: getDocHeadings(config, page), html: "" } : await renderDoc(config, page);
---

<DocsLayout page={page} headings={doc.headings}>
  {MdxContent ? <MdxContent /> : <Fragment set:html={doc.html} />}
</DocsLayout>
