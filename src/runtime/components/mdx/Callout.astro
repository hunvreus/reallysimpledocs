---
import * as lucideIcons from "lucide-static";
import { addSvgClass } from "../../lib/html.js";

const { type, title = "Note", icon: iconName, action, class: className = "" } = Astro.props;
const normalizedType = String(type || "").toLowerCase();
const calloutType = normalizedType === "warning" || normalizedType === "destructive" ? normalizedType : "";
const actionLabel = typeof action?.label === "string" ? action.label.trim() : "";
const actionHref = typeof action?.href === "string" ? action.href.trim() : "";

function resolveNamedIcon(name) {
  if (!name || typeof name !== "string") return "";
  const trimmed = name.trim();
  if (!trimmed) return "";
  if (trimmed.startsWith("<svg")) return trimmed;
  const pascalName = trimmed.includes("-")
    ? trimmed
        .split("-")
        .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
        .join("")
    : trimmed.charAt(0).toUpperCase() + trimmed.slice(1);
  return lucideIcons[pascalName] || "";
}

const iconSource = typeof iconName === "string" ? resolveNamedIcon(iconName) : "";
const icon = addSvgClass(iconSource, "size-4");
const heading = title;
---

<div class:list={["alert", className]} data-variant={calloutType || undefined}>
  {icon && <Fragment set:html={icon} />}
  <h3>{heading}</h3>
  <section>
    <slot />
  </section>
  {
    actionLabel && actionHref && (
      <footer>
        <a class="btn" data-variant="outline" data-size="sm" href={actionHref}>
          {actionLabel}
        </a>
      </footer>
    )
  }
</div>
