---
import CircleAlert from "lucide-static/icons/circle-alert.svg?raw";
import Info from "lucide-static/icons/info.svg?raw";
import Lightbulb from "lucide-static/icons/lightbulb.svg?raw";
import TriangleAlert from "lucide-static/icons/triangle-alert.svg?raw";
import * as lucideIcons from "lucide-static";
import { addSvgClass } from "../../lib/html.js";

const { type, variant, title, icon: showIcon = true, class: className = "" } = Astro.props;
const normalizedType = String(variant || type || "note").toLowerCase();
const calloutType = normalizedType === "note" ? "info" : normalizedType;
const destructive = calloutType === "danger";
const labels = {
  note: "Note",
  info: "Info",
  tip: "Tip",
  warning: "Warning",
  danger: "Danger",
};
const icons = {
  note: Info,
  info: Info,
  tip: Lightbulb,
  warning: TriangleAlert,
  danger: CircleAlert,
};

function resolveNamedIcon(name) {
  if (!name || typeof name !== "string") return "";
  const trimmed = name.trim();
  if (!trimmed) return "";
  if (trimmed.startsWith("<svg")) return trimmed;
  const pascalName = trimmed.includes("-")
    ? trimmed
        .split("-")
        .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
        .join("")
    : trimmed.charAt(0).toUpperCase() + trimmed.slice(1);
  return lucideIcons[pascalName] || "";
}

const iconSource =
  showIcon === false ? "" : typeof showIcon === "string" ? resolveNamedIcon(showIcon) : icons[normalizedType] || Info;
const icon = addSvgClass(iconSource, "size-4");
const heading = title || labels[normalizedType] || labels.note;
---

<div class:list={[destructive ? "alert-destructive" : "alert", className]} data-variant={calloutType}>
  {icon && <Fragment set:html={icon} />}
  <h3>{heading}</h3>
  <section>
    <slot />
  </section>
</div>
