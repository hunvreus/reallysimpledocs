---
import Tabs from "./Tabs.astro";
import Code from "./Code.astro";

const { code, lang = "html", title = "Preview", class: className = "" } = Astro.props;
if (typeof code !== "string") throw new Error("Preview requires a code string for its source tab.");
---

<Tabs variant="line" tabs={[{ label: title, slot: "preview" }, { label: "Code", slot: "code" }]}>
  <div data-not-typeset slot="preview" class:list={["rounded-lg border p-4", className]}>
    <slot />
  </div>
  <Code slot="code" code={code} lang={lang} />
</Tabs>
