---
import Code from "./Code.astro";

const { code = "", lang = "html", title = "Preview", class: className = "" } = Astro.props;
const id = `rsd-preview-${Math.random().toString(36).slice(2)}`;
---

<div class="rsd-preview">
  <div class="tabs">
    <nav role="tablist" aria-orientation="horizontal" data-variant="line">
      <button
        type="button"
        role="tab"
        id={`${id}-preview-tab`}
        aria-controls={`${id}-preview-panel`}
        aria-selected="true"
        tabindex="0"
      >
        {title}
      </button>
      <button
        type="button"
        role="tab"
        id={`${id}-code-tab`}
        aria-controls={`${id}-code-panel`}
        aria-selected="false"
        tabindex="-1"
      >
        Code
      </button>
    </nav>
    <div
      role="tabpanel"
      id={`${id}-preview-panel`}
      aria-labelledby={`${id}-preview-tab`}
      tabindex="-1"
      aria-selected="true"
    >
      <div class:list={["rsd-preview-canvas", className]}>
        <slot />
      </div>
    </div>
    <div
      role="tabpanel"
      id={`${id}-code-panel`}
      aria-labelledby={`${id}-code-tab`}
      tabindex="-1"
      aria-selected="false"
      hidden
    >
      <Code code={code} lang={lang} />
    </div>
  </div>
</div>
