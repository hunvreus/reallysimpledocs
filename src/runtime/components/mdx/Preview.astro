---
import Code from "./Code.astro";

const { code = "", lang = "html", title = "Preview", class: className = "", defaultTab = "preview" } = Astro.props;
const id = `rsd-preview-${Math.random().toString(36).slice(2)}`;
const showCode = defaultTab === "code";
---

<div class="rsd-preview">
  <div class="tabs">
    <nav role="tablist" aria-orientation="horizontal" data-variant="line">
      <button
        type="button"
        role="tab"
        id={`${id}-preview-tab`}
        aria-controls={`${id}-preview-panel`}
        aria-selected={showCode ? "false" : "true"}
        tabindex={showCode ? "-1" : "0"}
      >
        {title}
      </button>
      <button
        type="button"
        role="tab"
        id={`${id}-code-tab`}
        aria-controls={`${id}-code-panel`}
        aria-selected={showCode ? "true" : "false"}
        tabindex={showCode ? "0" : "-1"}
      >
        Code
      </button>
    </nav>
    <div
      role="tabpanel"
      id={`${id}-preview-panel`}
      aria-labelledby={`${id}-preview-tab`}
      tabindex="-1"
      aria-selected={showCode ? "false" : "true"}
      hidden={showCode}
    >
      <div class:list={["rsd-preview-canvas", className]}>
        <slot />
      </div>
    </div>
    <div
      role="tabpanel"
      id={`${id}-code-panel`}
      aria-labelledby={`${id}-code-tab`}
      tabindex="-1"
      aria-selected={showCode ? "true" : "false"}
      hidden={!showCode}
    >
      <Code code={code} lang={lang} />
    </div>
  </div>
</div>
