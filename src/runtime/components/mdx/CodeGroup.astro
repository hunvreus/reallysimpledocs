---
const { defaultTab, class: className = "" } = Astro.props;
const id = `code-group-${Math.random().toString(36).slice(2)}`;
const slotHtml = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const normalizedTabs = parseCodeTabs(slotHtml);
const defaultValue = defaultTab || normalizedTabs[0]?.value;

function parseCodeTabs(html) {
  const blocks = [];
  const pattern =
    /<div\b(?=[^>]*\bclass="[^"]*\bcode-block\b[^"]*")(?=[^>]*\bdata-code-title="([^"]*)")[^>]*>([\s\S]*?)<\/div>/g;
  let match;
  while ((match = pattern.exec(html))) {
    const label = decodeHtml(match[1]).trim();
    if (!label) continue;
    blocks.push({
      label,
      value: label,
      html: match[0],
    });
  }
  return blocks;
}

function decodeHtml(value) {
  return String(value || "")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&amp;/g, "&")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'");
}
---

<div class:list={["code-group", className]}>
  <header>
    <div class="tabs">
      <nav role="tablist" aria-orientation="horizontal" data-variant="line">
        {
          normalizedTabs.map((tab, index) => {
            const selected = tab.value === defaultValue;
            return (
              <button
                type="button"
                role="tab"
                id={`${id}-tab-${index + 1}`}
                aria-controls={`${id}-panel-${index + 1}`}
                aria-selected={selected ? "true" : "false"}
                tabindex={selected ? "0" : "-1"}
              >
                {tab.label}
              </button>
            );
          })
        }
      </nav>
    </div>
  </header>
  {
    normalizedTabs.map((tab, index) => {
      const selected = tab.value === defaultValue;
      return (
        <div
          role="tabpanel"
          id={`${id}-panel-${index + 1}`}
          aria-labelledby={`${id}-tab-${index + 1}`}
          tabindex="-1"
          aria-selected={selected ? "true" : "false"}
          hidden={!selected}
        >
          <Fragment set:html={tab.html} />
        </div>
      );
    })
  }
</div>
