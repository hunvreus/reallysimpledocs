---
import Code from "./Code.astro";

const { tabs = [], defaultTab, class: className = "" } = Astro.props;
const id = `rsd-code-group-${Math.random().toString(36).slice(2)}`;
const normalizedTabs = tabs.map((tab, index) => ({
  ...tab,
  value: tab.value || tab.label || String(index),
  lang: tab.lang || "text",
  code: tab.code || "",
}));
const defaultValue = defaultTab || normalizedTabs[0]?.value;
---

<div class:list={["rsd-code-group", className]}>
  <div class="tabs">
    <nav role="tablist" aria-orientation="horizontal" data-variant="line">
      {
        normalizedTabs.map((tab, index) => {
          const selected = tab.value === defaultValue;
          return (
            <button
              type="button"
              role="tab"
              id={`${id}-tab-${index + 1}`}
              aria-controls={`${id}-panel-${index + 1}`}
              aria-selected={selected ? "true" : "false"}
              tabindex={selected ? "0" : "-1"}
            >
              {tab.label}
            </button>
          );
        })
      }
    </nav>
    {
      normalizedTabs.map((tab, index) => {
        const selected = tab.value === defaultValue;
        return (
          <div
            role="tabpanel"
            id={`${id}-panel-${index + 1}`}
            aria-labelledby={`${id}-tab-${index + 1}`}
            tabindex="-1"
            aria-selected={selected ? "true" : "false"}
            hidden={!selected}
          >
            <Code code={tab.code} lang={tab.lang} />
          </div>
        );
      })
    }
  </div>
</div>
