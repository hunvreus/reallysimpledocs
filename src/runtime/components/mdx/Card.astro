---
const { title, description, href, class: className = "" } = Astro.props;
const Tag = href ? "a" : "article";
---

<Tag href={href} class:list={["card no-underline", href && "docs-card-link", className]}>
  {(title || description) && (
    <header>
      {title && <h3>{title}</h3>}
      {description && <p>{description}</p>}
    </header>
  )}
</Tag>
