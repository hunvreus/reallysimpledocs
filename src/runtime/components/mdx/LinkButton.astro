---
const { href, variant = "default", class: className = "", target, rel } = Astro.props;
const variants = {
  default: "btn",
  secondary: "btn-secondary",
  outline: "btn-outline",
  ghost: "btn-ghost",
  link: "btn-link",
};
---

<a href={href} target={target} rel={rel} class:list={[variants[variant] || "btn", className]}>
  <slot />
</a>
