---
import { renderCodeBlock } from "../../lib/code-block.js";
import config from "virtual:reallysimpledocs/config";
import { highlightCode } from "../../lib/highlight.js";
import { decodeHtml } from "../../lib/html.js";

const { lang = "text", title, code, copy = true, class: className = "" } = Astro.props;
const slotHtml = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const rawCode = typeof code === "string" ? code : decodeSlotText(slotHtml);
const html = await highlightCode(rawCode, lang, config.shiki);

function decodeSlotText(value) {
  const text = String(value || "")
    .replace(/^<p>/, "")
    .replace(/<\/p>$/, "");
  return decodeHtml(text).trim();
}
---

<Fragment set:html={renderCodeBlock(html, { title, copy, className, actions: await Astro.slots.render("actions") })} />
