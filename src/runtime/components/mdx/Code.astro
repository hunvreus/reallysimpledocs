---
import { codeToHtml } from "shiki";

const { code = "", lang = "text", title, class: className = "" } = Astro.props;
const highlightLang = String(lang || "text").toLowerCase() === "mdx" ? "tsx" : String(lang || "text");
const html = await codeToHtml(String(code || ""), {
  lang: highlightLang,
  themes: {
    light: "github-light",
    dark: "github-dark",
  },
  defaultColor: false,
});
---

<div class:list={["code-block", className]}>
  {title && <header>{title}</header>}
  <Fragment set:html={html} />
</div>
