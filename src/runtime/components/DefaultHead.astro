---
import basecoatJsUrl from "basecoat-css/all.min?url";
---

<script is:inline>
  (() => {
    try {
      const stored = localStorage.getItem("themeMode");
      if (
        stored
          ? stored === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches
      ) {
        document.documentElement.classList.add("dark");
      }
    } catch (_) {}
  })();
</script>
<script is:inline src={basecoatJsUrl}></script>
