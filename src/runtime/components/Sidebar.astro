---
import config from "virtual:reallysimpledocs/config";
import SidebarHeader from "virtual:reallysimpledocs/components/SidebarHeader";
import SidebarFooter from "virtual:reallysimpledocs/components/SidebarFooter";
import { renderSidebarContent } from "../lib/macros.js";
import { getSite } from "../lib/site.js";

const { menu } = Astro.props;
const site = getSite(config);
---

<aside id="sidebar" class="sidebar" data-side="left" aria-hidden="false">
  <nav aria-label="Sidebar navigation">
    <header>
      <SidebarHeader site={site} />
    </header>
    <section class="scrollbar">
      <Fragment set:html={renderSidebarContent(menu, "sidebar-content")} />
    </section>
    <footer>
      <SidebarFooter site={site} />
    </footer>
  </nav>
</aside>

<script>
  const sidebar = document.getElementById("sidebar");
  const viewport = sidebar?.querySelector("nav > section");
  let pending = false;

  function showCurrentPage() {
    pending = false;
    if (!sidebar || !viewport || sidebar.getAttribute("aria-hidden") === "true") return;
    const current = viewport.querySelector('a[aria-current="page"]');
    if (!current || !current.getClientRects().length) return;

    const item = current.getBoundingClientRect();
    const bounds = viewport.getBoundingClientRect();
    if (item.top < bounds.top) viewport.scrollBy(0, item.top - bounds.top);
    else if (item.bottom > bounds.bottom) viewport.scrollBy(0, item.bottom - bounds.bottom);
  }

  function scheduleScroll() {
    if (pending) return;
    pending = true;
    requestAnimationFrame(showCurrentPage);
  }

  if (sidebar && viewport) {
    const observer = new MutationObserver(scheduleScroll);
    observer.observe(sidebar, {
      attributes: true,
      attributeFilter: ["aria-current", "aria-hidden", "open"],
      subtree: true,
    });
    scheduleScroll();
  }
</script>
